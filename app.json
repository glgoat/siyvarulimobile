{
  "expo": {
    "name": "Siyvaruli",
    "slug": "siyvaruli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "siyvaruli",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ge.siyvaruli.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#501631",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "siyvaruli.ge-სთვის შენი ქალაქის ავტომატურად დასადგენად საჭიროა მდებარეობა."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "სელფის ვერიფიკაციისთვის საჭიროა კამერაზე წვდომა."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "Siyvaruli uses this permission to support relevant advertising.",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
